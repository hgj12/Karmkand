<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_gold">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#FFFFE082"
                android:centerColor="#FFFFCA28"
                android:endColor="#FFF5B025"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#80B37D1A" />
        </shape>
    </item>
</ripple>
