<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_gold">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="145"
                android:startColor="#4D7B1118"
                android:centerColor="#3352090F"
                android:endColor="#26241217"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="@color/glass_border_focused" />
        </shape>
    </item>
</ripple>
